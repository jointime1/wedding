---
import Ornament from './Ornament.astro';

// Wedding venue — Концертно-банкетный зал «Торне», с. Гизель (под Владикавказом).
const query = 'Торне, Гизельское шоссе 26, Гизель';
const enc = encodeURIComponent(query);
const yandexEmbed = `https://yandex.ru/map-widget/v1/?text=${enc}&z=15`;
const yandexRoute = `https://yandex.ru/maps/?rtext=~${enc}&rtt=auto`; // route to the venue (origin = guest's location)
const gisSearch = `https://2gis.ru/vladikavkaz/search/${enc}`;        // self-correcting search, lands on the venue card
---
<section id="venue" class="section relative">
  <div class="container-wide">
    <div class="text-center reveal">
      <p class="eyebrow"><span class="dot-ornament"></span>Место<span class="dot-ornament"></span></p>
      <h2 class="mt-4 text-5xl md:text-7xl font-display [text-wrap:balance]">
        Зал <span class="serif-italic text-terracotta underline-hand">«Торне»</span>
      </h2>
      <div class="mt-6 text-ink/50 mx-auto"><Ornament variant="rule" /></div>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-2 md:items-stretch">
      <!-- Info card -->
      <article data-tilt class="tilt-card ornate-frame relative bg-paper vintage-border p-8 sm:p-10 md:p-12 overflow-hidden reveal">
        <span class="corner-bl"></span><span class="corner-br"></span>
        <div class="grain"></div>
        <span class="tilt-shine"></span>

        <div class="relative">
          <p class="eyebrow">Где встречаемся</p>
          <h3 class="mt-4 font-display text-3xl md:text-4xl leading-[0.95]">
            Концертно-банкетный зал <span class="serif-italic text-terracotta">«Торне»</span>
          </h3>
          <p class="mt-3 font-serif italic text-xl text-ink/80">с. Гизель, Гизельское шоссе, 26</p>
          <p class="mt-1 font-mono text-[0.6rem] tracking-editorial uppercase text-muted">
            ~7 км к западу от центра Владикавказа
          </p>

          <div class="mt-8 flex items-center gap-4 text-clay/40">
            <span class="hair-rule flex-1"></span>
            <Ornament variant="diamond" class="w-4 h-4 text-clay" />
            <span class="hair-rule flex-1"></span>
          </div>

          <dl class="mt-8 grid grid-cols-2 gap-6 text-sm">
            <div>
              <dt class="eyebrow">Начало</dt>
              <dd class="mt-2 font-serif italic text-lg">19 сентября, 15:00</dd>
            </div>
            <div>
              <dt class="eyebrow">Дорога</dt>
              <dd class="mt-2 font-serif italic text-lg">~15–20 мин от центра</dd>
            </div>
          </dl>

          <p class="mt-8 leading-[1.85] text-ink/80">
            Зал — за городом, в&nbsp;Гизели. Удобнее всего добраться на машине или такси: примерно 15–20&nbsp;минут от центра Владикавказа. Нужна помощь с&nbsp;трансфером — <a href="#contacts" class="underline-hand text-terracotta">напишите нам</a>.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={yandexRoute}
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic="14"
              class="magnetic group relative inline-flex items-center gap-3 overflow-hidden bg-ink px-8 py-4 font-mono text-xs tracking-editorial uppercase text-paper transition-all hover:bg-terracotta cursor-pointer"
            >
              <span class="relative z-10">Построить маршрут</span>
              <svg width="22" height="10" viewBox="0 0 22 10" fill="none" class="relative z-10 transition-transform group-hover:translate-x-1" aria-hidden="true">
                <path d="M0 5 H20 M15 1 L20 5 L15 9" stroke="currentColor" stroke-width="1" />
              </svg>
            </a>
            <a
              href={gisSearch}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-ink/30 px-8 py-4 font-mono text-xs tracking-editorial uppercase text-ink transition-colors hover:border-terracotta hover:text-terracotta cursor-pointer"
            >
              Открыть в&nbsp;2ГИС
            </a>
          </div>
        </div>
      </article>

      <!-- Map in a vintage frame -->
      <div class="relative reveal">
        <span class="tape hidden md:block -top-3 right-10 w-24 h-6 rotate-6"></span>
        <div class="relative h-full min-h-[20rem] vintage-border bg-bone p-2 overflow-hidden">
          <span class="corner-bl"></span><span class="corner-br"></span>
          <iframe
            src={yandexEmbed}
            title="Карта — зал «Торне», с. Гизель, Гизельское шоссе, 26"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            class="relative z-10 w-full h-full min-h-[19rem] border-0"
            style="filter: sepia(0.12) contrast(1.02);"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
